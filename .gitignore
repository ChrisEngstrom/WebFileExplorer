# ASP.NET Core, Visual Studio and VS Code
# Adapted from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
# and https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore

# Generated build and publish output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
.artifacts/
publish/

# IDE caches and user-specific settings
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.rsuser
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user
_ReSharper*/

# Test results and coverage
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
coverage*.xml
coverage*.json
coverage*.info
coverage-report/
BenchmarkDotNet.Artifacts/

# Local secrets, data and uploads
.env
.env.*
!.env.example
*.pfx
*.p12
*.publishsettings
*.pubxml
/src/WebFileExplorer.WebApp/appsettings.Local.json
/Data/
/DemoUploads/

# TypeScript build output. Build regenerates these from Scripts/app.ts.
/src/WebFileExplorer.WebApp/wwwroot/js/app.js
/src/WebFileExplorer.WebApp/wwwroot/js/app.js.map
*.tsbuildinfo
node_modules/

# OS and temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.log

# Share only explicitly listed fictional fixtures.
# New uploads anywhere under SampleData remain ignored, including subfolders.
